# MiniClaude 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
MINI_HOST=127.0.0.1
MINI_PORT=7437

# ── Logging ───────────────────────────────────────────────────
MINI_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
MINI_LOG_FILE=~/.mini/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
MINI_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# MINI_CONFIG=~/.mini/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# MINI_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# MINI_MAX_STEPS=20

# ── 联网工具（搜索 / 网页正文 / 浏览器）────────────────────────
# 搜索使用 DDGS，无需搜索 API key；浏览器需要 Node.js 20+ 和 Chrome
# MINI_NETWORK_ENABLED=true
# MINI_BROWSER_ENABLED=true
# false 时显示独立浏览器窗口，可在当前任务中手动登录
# MINI_BROWSER_HEADLESS=true
# 使用非默认 Chrome 安装时设置可执行文件绝对路径
# MINI_BROWSER_EXECUTABLE_PATH=/path/to/chrome
# DDGS 搜索代理；网页抓取使用 HTTP_PROXY / HTTPS_PROXY / ALL_PROXY 和 NO_PROXY
# DDGS_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
